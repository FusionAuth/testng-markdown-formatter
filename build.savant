project(group: "io.fusionauth",
        name: "testng-markdown-formatter",
        version: "1.3.0",
        licenses: ["ApacheV2_0"]) {
    workflow {
        fetch {
            // Dependency resolution order:
            //
            // 1. Hit the savant cache
            cache()
            //
            // 2. Look in public savant repo
            url(url: "https://repository.savantbuild.org")
            //
            // 3. No dice, see if we can find it in Maven central
            maven()
        }
        publish {
            cache()
        }
        semanticVersions {
            // transitive dependencies of com.google.guava:guava:guava:jar:32.1.2-jre
            mapping(id: "com.google.guava:listenablefuture:9999.0-empty-to-avoid-conflict-with-guava", version: "9999.0.0")
            // in parent POM of listenablefuture artifact
            mapping(id: "com.google.guava:guava-parent:26.0-android", version: "26.0.0")
        }
    }

    publishWorkflow {
        subversion(repository: "https://svn.savantbuild.org")
    }

    dependencies {
        group(name: "compile") {
            dependency(id: "org.testng:testng:7.8.0")
        }
        group(name: "runtime") {
            // testNG seems to depend on this
            dependency(id: "com.google.inject:guice:6.0.0")
        }
        group(name: "test-compile", export: false) {
            dependency(id: "org.mockito:mockito-core:5.20.0")
        }
    }

    publications {
        standard()
    }
}

// Plugins

dependency = loadPlugin(id: "org.savantbuild.plugin:dependency:2.0.1")
java = loadPlugin(id: "org.savantbuild.plugin:java:2.0.0")
javaTestNG = loadPlugin(id: "org.savantbuild.plugin:java-testng:2.0.0")
idea = loadPlugin(id: "org.savantbuild.plugin:idea:2.0.2")
linter = loadPlugin(id: "org.savantbuild.plugin:linter:2.1.0")
pom = loadPlugin(id: "org.savantbuild.plugin:pom:2.0.1")
release = loadPlugin(id: "org.savantbuild.plugin:release-git:2.0.0")

// Plugin settings
java.settings.javaVersion = "25"
javaTestNG.settings.javaVersion = "25"

target(name: "clean", description: "Cleans the project") {
    java.clean()
}

target(name: "compile", description: "Compiles the project") {
    java.compile()
}

target(name: "jar", description: "JARs the project", dependsOn: ["compile"]) {
    java.jar()
}

target(name: "test", description: "Runs the project's tests", dependsOn: ["jar"]) {
    javaTestNG.test()
}

target(name: "pom", description: "Updates the pom.xml file") {
    pom.update()

    ensureFileNotChanged("pom.xml", "pom")
}

def ensureFileNotChanged(String filename, String target) {
    if (!cleanExecute("git",
            "diff",
            "--exit-code",
            filename)) {
        fail(
                "${filename} was changed. If this is not being run locally, run the [${target}] Savant target locally to update the file and commit/push the result.")
    }
}

boolean cleanExecute(String... args) {
    ProcessBuilder pb = new ProcessBuilder(args)
    return execute(pb, '.')
}

boolean execute(ProcessBuilder pb, String pathname) {
    def process = pb.inheritIO().directory(new File(pathname)).start()
    process.consumeProcessOutput(System.out, System.err)
    process.waitFor()
    return process.exitValue() == 0
}

target(name: "int", description: "Releases a local integration build of the project", dependsOn: ["test", "pom", "idea"]) {
    dependency.integrate()
}

target(name: "release", description: "Releases a full version of the project", dependsOn: ["clean", "test"]) {
    release.release()
}

target(name: "idea", description: "Updates the IntelliJ IDEA module file") {
    idea.iml()

    ensureFileNotChanged("testng-markdown-formatter.iml", "idea")
}

target(name: "pmd", description: "Lints the code", dependsOn: ["compile"]) {
    linter.pmd(
            ruleSets: ["src/test/resources/pmd/ruleset.xml"],
            languageVersion: "21",
            minimumPriority: "LOW"
    )
}
